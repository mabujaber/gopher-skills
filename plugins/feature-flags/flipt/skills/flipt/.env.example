# Flipt Feature Flag Management Configuration
#
# This skill manages Flipt feature flags for controlled rollouts.
# Configure the Flipt server URL and API token below.

# Flipt server URL
# The base URL of your Flipt instance (default below is a local Flipt server)
FLIPT_URL=http://localhost:8080

# Flipt API token
# A token with read/write access to manage flags
# For read-only operations, use the fetcher token
# For write operations, you need an admin token
FLIPT_API_TOKEN=your-api-token-here

# Git state repository (optional, only if you use Flipt GitOps backend)
# The repository where Flipt stores flag definitions
# FLIPT_STATE_REPO=your-org/flipt-state
